@model Product
@{
    ViewData["Title"] = Model.Name;
    int imgTab = 2;
}
<div class="ht__bradcaump__area" style="background: rgba(0, 0, 0, 0) url(../assets/images/bg/2.jpg) no-repeat scroll center center / cover ;">
    <div class="ht__bradcaump__wrap">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <div class="bradcaump__inner text-center">
                        <h2 class="bradcaump-title">Product Details</h2>
                        <nav class="bradcaump-inner">
                            <a class="breadcrumb-item" asp-action="Index" asp-controller="Home">Home</a>
                            <span class="brd-separetor">/</span>
                            <span class="breadcrumb-item active">Product Details</span>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- End Bradcaump area -->

<!-- Start Product Details -->
<section class="htc__product__details pt--120 pb--100 bg__white">
    <div class="container">
        <div class="row">
            <!-- Left Sidebar Images -->
            <div class="col-md-3 col-sm-3">
                <ul class="nav product__small__images flex-column" role="tablist">
                    <li role="presentation" class="pot-small-img mb-3">
                        <a class="active" href="#img-tab-1" role="tab" data-bs-toggle="tab">
                            <img width="90px" height="150px" src="~/imgs/products/@Model.CoverImage" alt="small-image">
                        </a>
                    </li>
                    @foreach (var item in Model.Images?.Select(x => x.ImageUrl) ?? [])
                    {
                        <li role="presentation" class="pot-small-img mb-3">
                            <a href="#img-tab-@(imgTab++)" role="tab" data-bs-toggle="tab">
                                <img width="80px" height="200px" src="~/imgs/products/@item" alt="small-image">
                            </a>
                        </li>
                    }
                </ul>
            </div>

            <!-- Main Product Image -->
            <div class="col-md-6 col-sm-9">
                <div class="product__big__images">
                    <div class="portfolio-full-image tab-content">
                        <div role="tabpanel" class="tab-pane active" id="img-tab-1">
                            <img width="450px" height="660px" src="~/imgs/products/@Model.CoverImage" alt="full-image">
                        </div>
                        @{ imgTab = 2; }
                        @foreach (var item in Model.Images?.Select(x => x.ImageUrl) ?? [])
                        {
                            <div role="tabpanel" class="tab-pane" id="img-tab-@(imgTab++)">
                                <img width="440px" height="590px" src="~/imgs/products/@item" alt="full-image">
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Product Details -->
            <div class="col-md-3 col-sm-12">
                <div class="htc__product__details__inner">
                    <div class="pro__detl__title">
                        <h2>@Model.Name</h2>
                    </div>
                    @if (User.Identity?.IsAuthenticated ?? false)
                    {
                        <form asp-action="Rate" asp-controller="Shop">
                            <input type="hidden" name="productId" value="@Model.Id" />
                            <input type="number" name="rate" min="1" max="5" value="@ViewBag.Rating" /> 
                            <button class="btn">Rate</button>

                        </form>
                    }
                    <div class="pro__dtl__rating">

                        <ul class="pro__rating">
                            @if (Model.ProductRatings.Count > 0)
                            {
                                int i = 0;
                                for (; i < Math.Ceiling(Model.ProductRatings.Average(x => x.RatingRate)); i++)
                                {
                                    <li><span class="zmdi zmdi-star"></span></li>
                                }
                                for (; i < 5; i++)
                                {
                                    <li><span class="ti-star"></span></li>
                                }
                            }
                        </ul>
                        <span class="rat__qun">(Based on @Model.ProductRatings.Count Ratings)</span>
                    </div>
                    <div class="pro__details">
                    <div class="pro__details mb-3">
                        <p>@Model.Description</p>
                    </div>
                    <ul class="pro__dtl__prize mb-3">
                        @if (Model.Discount > 0)
                        {
                            <li class="old__prize">$@Model.SellPrice</li>
                            <li>$@(Model.SellPrice * (100 - Model.Discount) / 100)</li>
                        }
                        else
                        {
                            <li>$@Model.SellPrice</li>
                        }
                    </ul>
                    <div class="product-action-wrap mb-3">
                        <div class="prodict-statas"><span>@Model.PCount :</span></div>
                        <div class="product-quantity">
                            <form id='myform' method='POST' action='#'>
                                <div class="cart-plus-minus">
                                    <input class="cart-plus-minus-box" type="text" name="qtybutton" value="02">
                                </div>
                            </form>
                        </div>
                    </div>
                    <ul class="pro__dtl__btn">
                        <li class="buy__now__btn"><a href="#">buy now</a></li>
                        <li><a href="#"><span class="ti-heart"></span></a></li>
                        <li><a href="#"><span class="ti-email"></span></a></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>
        <!-- Start Product tab -->
        <section class="htc__product__details__tab bg__white pb--120">
            <div class="container">
                <div class="row">
                    <div class="col-md-12 col-lg-12 col-sm-12">
                        <ul class="nav product__deatils__tab mb--60" role="tablist">
                            <li role="presentation" class="active">
                                <a class="active" href="#description" role="tab" data-bs-toggle="tab">Description</a>
                            </li>
                            <li role="presentation">
                                <a href="#sheet" role="tab" data-bs-toggle="tab">Data sheet</a>
                            </li>
                            <li role="presentation">
                                <a href="#reviews" role="tab" data-bs-toggle="tab">Reviews</a>
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12">
                        <div class="product__details__tab__content">
                            <!-- Start Single Content -->
                            <div role="tabpanel" id="description" class="product__tab__content active">
                                <div class="product__description__wrap">
                                    <div class="product__desc">
                                        <h2 class="title__6">Details</h2>
